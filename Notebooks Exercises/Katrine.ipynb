   "outputs": [],
   "source": [
    "def cost_of_route(route, distance_matrix):\n",
    "    cost = []\n",
    "    for i in range(len(route)):\n",
    "        cost.append( distance_matrix[route[i], route[(i+1) % len(route)]])\n",
    "    \n",
    "    return np.sum(cost)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 129,
   "id": "db89e72d",
   "metadata": {},
   "outputs": [],
   "source": [
    "def TSP(n, points, max_iter): \n",
    "    distances = np.linalg.norm(\n",
    "    points[:, np.newaxis] - points[np.newaxis, :],\n",
    "    axis=2)\n",
    "\n",
    "    route_current = np.arange(n)\n",
    "    np.random.shuffle(route_current)\n",
    "    \n",
    "    cost_current = cost_of_route(route_current, distances)\n",
    "\n",
    "    for k in range(max_iter):\n",
    "        # Cooling schedule\n",
    "        T = 1 / np.sqrt(1 + k)\n",
    "\n",
    "        # Proposal route \n",
    "        route_proposal = route_current.copy()\n",
    "\n",
    "        i, j = np.random.choice(n, 2, replace=False)\n",
    "        route_proposal[i], route_proposal[j] = route_proposal[j], route_proposal[i]\n",
    "\n",
    "        cost_proposal = cost_of_route(route_proposal, distances)\n",
    "        diff = cost_proposal - cost_current\n",
    "\n",
    "        if cost_proposal <= cost_current: \n",
    "            accept = True\n",
    "        \n",
    "        else: \n",
    "            accept = np.random.rand() < np.exp(-diff/T)\n",
    "        \n",
    "        if accept: \n",
    "            route_current = route_proposal\n",
    "            cost_current = cost_proposal\n",
    "    \n",
    "    return route_current, cost_current\n",
    "\n",
    "\n"
   ]
  },
