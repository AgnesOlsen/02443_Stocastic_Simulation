    "    sample = []\n",
    "    for _ in range(n):\n",
    "        rho = 0.5\n",
    "\n",
    "        mean = [0, 0]\n",
    "        cov = [[1, rho],\n",
    "            [rho, 1]]\n",
    "\n",
    "        xi, gamma = np.random.multivariate_normal(mean, cov)\n",
    "        theta = np.exp(xi)\n",
    "        psi = np.exp(gamma)\n",
    "        sample.append((theta,psi))\n",
    "    \n",
    "    return sample"
