   "source": [
    "def metropolis_hastings_direct(n, burn_in, A1, A2,m):\n",
    "    # Input: n: number of samples, burn_in: burn in period, A1, A2: paramters of the distribution, m: number of servers\n",
    "    # Output: Generated samples\n",
    "\n",
    "    X1 = 0 \n",
    "    X2 = 0\n",
    "    samples = []\n",
    "\n",
    "    for _ in range(n):\n",
    "\n",
    "        # Direct implementation\n",
    "        move = np.random.choice(4)\n",
    "\n",
    "        if move == 0:\n",
    "            Y1, Y2 = X1 + 1, X2\n",
    "        elif move == 1:\n",
    "            Y1, Y2 = X1 - 1, X2\n",
    "        elif move == 2:\n",
    "            Y1, Y2 = X1, X2 + 1\n",
    "        else:\n",
    "            Y1, Y2 = X1, X2 - 1\n",
    "\n",
    "        \n",
    "        # reject invalid states\n",
    "  \n",
    "        if Y1 < 0 or Y2 < 0 or Y1 + Y2 > m:\n",
    "            Y1, Y2 = X1, X2   # stay in place\n",
    "\n",
    "     \n",
    "        # MH acceptance step\n",
    "\n",
    "        alpha = min(1, g_2(Y1, Y2, A1, A2) / g_2(X1, X2, A1, A2))\n",
    "\n",
    "        if np.random.rand() < alpha:\n",
    "            X1, X2 = Y1, Y2\n",
    "\n",
    "        samples.append((X1, X2))\n",
    "\n",
    "    return samples[burn_in:]"
   ]
  },
