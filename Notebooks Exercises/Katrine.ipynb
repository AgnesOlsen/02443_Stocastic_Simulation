    "def correlation_test(obs,h):\n",
    "    \"\"\" \n",
    "    Do a correlation test \n",
    "    Input: \n",
    "        obs: list of observations \n",
    "        h: lag \n",
    "    \n",
    "    Output: p-value for the correlation test \n",
    "    \"\"\"\n",
    "    obs = np.array(RN)\n",
    "    n= len(obs)\n",
    "    c = np.sum(obs[:-h] * obs[h:]) / (n - h)\n",
    "\n",
    "    mean = 0.25\n",
    "    var = 7/(144*n)\n",
    "    z = (c - mean)/np.sqrt(var)\n",
    "    \n",
    "    p_values = 2*norm.sf(abs(z))\n",
    "    return p_values"
   ]
  },
