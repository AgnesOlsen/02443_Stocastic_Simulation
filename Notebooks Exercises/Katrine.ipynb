    "def gibbs_sampling(n, burn_in, A1, A2,m): \n",
    "    # Input: n: number of samples, burn_in: burn in period, A1, A2: paramters of the distribution, m: number of servers\n",
    "    # Output: Generated samples\n",
    "\n",
    "    X1 = 0 \n",
    "    X2 = 0 \n",
    "    samples = []\n",
    "    \n",
    "    for _ in range(n):\n",
    "\n",
    "        # Sample X1 | X2 \n",
    "\n",
    "        max_i = m - X2\n",
    "        w1 = []\n",
    "        for i in range(max_i + 1):\n",
    "            w1.append(g_poisson(i, A1))\n",
    "        p1 = w1/np.sum(w1)\n",
    "        X1 = np.random.choice(len(p1), p = p1)\n",
    "\n",
    "        # Sample X2 | X1\n",
    "\n",
    "        max_j = m - X1\n",
    "        w2 = []\n",
    "        for j in range(max_j + 1):\n",
    "            w2.append(g_poisson(j, A2))\n",
    "        p2 = w2/np.sum(w2)\n",
    "        X2 = np.random.choice(len(p2), p = p2)\n",
    "\n",
    "        samples.append((X1,X2))\n",
    "    \n",
    "    return samples[burn_in:]\n",
    "\n",
    "    "
   ]
  },
