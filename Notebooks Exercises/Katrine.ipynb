   "source": [
    "def g_2(i, j, A1, A2): \n",
    "    # Input: i,j: integers to be evaluated, A1, A2: Parameter value\n",
    "    # Output: Distribution value\n",
    "    t = A1**i * A2**j \n",
    "    n = math.factorial(i)*math.factorial(j)\n",
    "    return t/n"
   ]
  },
