    "plt.plot(ns, t_rej_list, marker='o', label='Rejection')\n",
    "plt.plot(ns, t_alias_list, marker='o', label='Alias')\n",
    "\n",
    "plt.xlabel(\"n (number of samples)\")\n",
    "plt.ylabel(\"Time (seconds)\")\n",
    "plt.title(\"Sampling Methods: Runtime vs n\")\n",
    "plt.legend()\n",
    "plt.grid(alpha=0.3)\n",
    "\n",
    "plt.show()"
   ]
