    "def crude_mc_rep(a, n):\n",
    "    # Input: a: value to evaluate, n: number of samples\n",
    "    # Output: probability \n",
    "    Z = np.random.normal(0,1,n)\n",
    "\n",
    "    return np.mean(np.mean(Z > a))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 82,
   "id": "9419e7db",
   "metadata": {},
   "outputs": [],
   "source": [
    "def importance_sample(a, std, n): \n",
    "    # Input: a: value to evaluate and mean for the normal distribution,\n",
    "    # std: standart diviasion of the normal distribution, n: number of samples \n",
    "    # Output: probability \n",
    "\n",
    "    Y = np.random.normal(a,std,n)\n",
    "\n",
    "    f = norm(loc=0, scale=1).pdf\n",
    "    g = norm(loc=a, scale=std).pdf\n",
    "\n",
    "    weigths = f(Y)/g(Y)\n",
    "\n",
    "    return np.mean((Y > a)*weigths)\n"
