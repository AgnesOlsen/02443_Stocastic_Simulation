    "# Pareto distribution \n",
    "\n",
    "beta = 1\n",
    "k = [2.05, 2.5,3,4]\n",
    "n = 10000\n",
    "\n",
    "def pareto_distrib(k, beta, n):\n",
    "    U = np.random.rand(n)\n",
    "    return beta*(U**(-1/k))\n",
    "\n",
    "for element in k: \n",
    "    # Simulate geometric sample \n",
    "    np.random.seed(42)\n",
    "    pareto_sample = pareto_distrib(element, beta, n)\n",
    " \n",
    "\n",
    "\n",
    "    # Theorical pdf\n",
    "    \n",
    "    x = np.linspace(np.min(pareto_sample), np.max(pareto_sample), 10000)\n",
    "    theoretical_pdf_par = element*beta**element/(x**(element+1))\n",
    "\n",
    "    np.random.seed(42)\n",
    "    # Bin edges smallest possible value is beta and then tails to infinity. \n",
    "    bin_edges =  np.array([beta, 1.2, 1.5, 1.8, 2.2, 3.0, 5.0, np.inf])\n",
    "    # Observed frequencies\n",
    "    observed, _ = np.histogram(pareto_sample, bins=bin_edges)\n",
    "\n",
    "    # Expected frequencies\n",
    "    theoretical_cdf = 1.0 - (beta / bin_edges) **element\n",
    "    expected = len(pareto_sample) * np.diff(theoretical_cdf)\n",
    "\n",
    "    # Chi-square goodness-of-fit test\n",
    "    chi2_stat, p_value = chisquare(\n",
    "    f_obs=observed,\n",
    "        f_exp=expected\n",
    "    )\n",
    "\n",
    "\n",
    "    \n",
    "    plt.figure(figsize=(10, 6))\n",
    "\n",
    "    plt.hist(pareto_sample, bins=100, density=True,\n",
    "            alpha=0.6, label=\"Empirical PDF\")\n",
    "\n",
    "    plt.plot(x, theoretical_pdf_par, 'r-', lw=2,\n",
    "            label=\"Theoretical PDF\")\n",
    "\n",
    "    plt.title(f\"Pareto Distribution (k = {element})\")\n",
    "\n",
    "    text = (\n",
    "    f\"Chi-square p-value = {p_value:.4f}\"\n",
    "     )\n",
