    "def stratified_sampling(strat_size): \n",
    "    # Input: strat_size: Number of stratas \n",
    "    # Output: One sampling\n",
    "    Y = []\n",
    "\n",
    "    for j in range(strat_size): \n",
    "        a = j/strat_size\n",
    "        b = (j+1)/strat_size\n",
    "\n",
    "        u = np.random.uniform(a,b)\n",
    "        Y.append(np.exp(u))\n",
    "\n",
    "    return np.mean(Y)\n",
    "\n",
    "def statified_stats(strat_size,n):\n",
    "    # Input: strat_size: Number of stratas, n: number of samples \n",
    "    # Output: mean, 95% confindence interval of sample \n",
    "\n",
    "    Y = []\n",
    "    for _ in range(int(n/strat_size)):\n",
    "        Y.append(stratified_sampling(strat_size))\n",
    "    mean_strat = np.mean(Y)\n",
    "    conf_strat = confidence_interval_95(Y)\n",
    "    return mean_strat, conf_strat\n",
    "\n",
    "\n"
   ]
  },
