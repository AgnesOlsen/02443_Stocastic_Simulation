    "def importance_sample_int(lam, n): \n",
    "    # Input: lam: lampda, n: number of samples \n",
    "    # Output: Esitmation of integral, Variation of estimate\n",
    "    Y =  np.random.exponential(1/lam,size=n) # Y follows same distribution as g\n",
    "\n",
    "\n",
    "    f = uniform.pdf(Y) # f is uniform distribution \n",
    "    g = lam*np.exp(-lam*Y) # g is exponential\n",
    "\n",
    "    h_Y = np.exp(Y)\n",
    "\n",
    "    E_h = np.mean(h_Y * (f/g))\n",
    "    var = np.var(h_Y * (f/g))/n # Variablity of estimate \n",
    "\n",
    "\n",
    "    return E_h, var"
