    "def antithetic_variables(n):\n",
    "    # Input: n: number of samples \n",
    "    # Output: mean, 95% confindence interval\n",
    "    U = np.random.rand(n)\n",
    "    X1 = np.exp(U)\n",
    "    X2 = np.exp(1-U)\n",
    "    Y = (X1 + X2)/2 \n",
    "    mean = np.mean(Y)\n",
    "    conf = confidence_interval_95(Y) \n",
    "    return mean, conf"
   ]
