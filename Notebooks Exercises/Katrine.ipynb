   "source": [
    "# Normal distribution through box-Müller \n",
    "np.random.seed(42)\n",
    "\n",
    "def norm_disp_gen(mu, std, n):\n",
    "    U1 = np.random.rand(n)\n",
    "    U2 = np.random.rand(n)\n",
    "    Z = np.sqrt(-2*np.log(U1))*np.cos(2*np.pi*U2)\n",
    "\n",
    "    return mu + std*Z"
   ]
  },
