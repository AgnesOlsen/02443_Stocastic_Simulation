    "# As in ex 4 \n",
    "# Create sample \n",
    "A = 8 \n",
    "m = 10\n",
    "n = 50000\n",
    "burn_in = 5000\n",
    "samples =metropolis_hastings(n, burn_in, A, m)[::10]\n",
    "\n",
    "# Expected distribution \n",
    "w = []\n",
    "for i in range(m+1): \n",
    "    w.append(g_poisson(i,A))\n",
    "\n",
    "expected = (w / np.sum(w) ) *(len(samples))\n",
    "\n",
    "observed = np.bincount(samples, minlength=m + 1)\n",
    "\n",
    "# Chisquare test \n",
    "chi2_stat, p_value = chisquare(observed, expected)\n",
    "\n",
    "print(\"Chi-square statistic =\", chi2_stat)\n",
    "print(\"p-value =\", p_value)"
   ]
