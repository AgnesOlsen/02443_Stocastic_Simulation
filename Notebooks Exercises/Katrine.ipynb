  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "0dc0cb92",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Implementation of linear congruential generator\n",
    "def LCG(x0, a, c, M, iter): \n",
    "    \"\"\"\n",
    "    Generate random numbers using a linear congrential generator\n",
    "    Input: \n",
    "        x0: Initial value \n",
    "        a: Multiplier \n",
    "        c: Increment \n",
    "        M: Modulus \n",
    "        Iter: How many number iterations\n",
    "\n",
    "    Output: A list of random number of length iter + 1.      \n",
    "    \"\"\"\n",
    "\n",
    "    # Set initial value  \n",
    "    x = x0 \n",
    "    Numbers = [x/M]\n",
    "\n",
    "    # Generate Random Numbers \n",
    "    for i in range(iter):\n",
    "        x = (a*x + c) % M \n",
    "        U = x/M \n",
    "        Numbers.append(U)\n",
    "    return Numbers"
   ]
  },
