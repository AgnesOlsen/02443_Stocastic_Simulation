    "# Computational efficiency (time)\n",
    "\n",
    "# Problem setup\n",
    "\n",
    "x = np.array([1,2,3,4,5,6])\n",
    "p = np.array([7/48, 5/48, 1/8, 1/16, 1/4, 5/16])\n",
