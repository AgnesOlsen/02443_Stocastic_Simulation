   "source": [
    "# Truncated poisson distribution\n",
    "def g_poisson(i, A):\n",
    "    # Input: i: integer to be evaluated, A: Parameter value\n",
    "    # Output: Distribution value\n",
    "    return A**i / math.factorial(i)\n",
    "\n",
    "\n",
    "def metropolis_hastings(n,burn_in, A,m):\n",
    "    # Input: n: number of samples, burn_in: burn in period, A: parameter value of truncated poisson distribution, m: number of servers\n",
    "    # Output: Generated samples\n",
    "\n",
    "    X = 0 \n",
    "    samples = []\n",
    "    acc_rate = 0\n",
    "    for _ in range(n):\n",
    "        \n",
    "        # Proposal: move up or down by 1\n",
    "        if X == 0:\n",
    "            Y = np.random.choice([0, 1])\n",
    "        elif X == m:\n",
    "            Y = m - np.random.choice([0, 1])\n",
    "        else:\n",
    "            Y = X + np.random.choice([-1, 1])\n",
    "        \n",
    "        \n",
    "        \n",
    "        alpha = min(1, g_poisson(Y, A)/g_poisson(X, A))\n",
    "\n",
    "        if np.random.rand() < alpha:\n",
    "            X = Y\n",
    "            acc_rate += 1\n",
    "\n",
    "\n",
    "        \n",
    "        samples.append(X)\n",
    "\n",
    "\n",
    "    return samples[burn_in:]\n",
    "\n",
    "      "
   ]
  },
